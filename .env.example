# Copiar a .env.local (desarrollo) y a las variables de entorno de Vercel (producción).
# NUNCA subir valores reales al repositorio.

# Postgres en Neon. La app usa la URL con pooler; Prisma CLI y psql usan la directa (prisma.config.ts).
# `neon env pull` las trae; añade JWT_SECRET a mano.
DATABASE_URL=postgresql://usuario:clave@host-pooler/basededatos?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://usuario:clave@host/basededatos?sslmode=verify-full

# Secreto largo y aleatorio para firmar JWT (p. ej. `openssl rand -base64 48`)
JWT_SECRET=cambia-esto

# LLM: Groq, endpoint compatible con OpenAI (verificado en su documentación, D-040).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Modelo de producción de Groq con salida JSON estricta y reasoning_effort (D-040). Respaldo: llama-3.3-70b-versatile.
LLM_MODEL=openai/gpt-oss-120b

# Embeddings: Gemini (clave de Google AI Studio). Modelo y dimensión FIJOS: cambiarlos obliga a recalcular todo.
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=gemini-embedding-001
EMBEDDINGS_DIM=768

# Máximo de caracteres de contexto por generación. 12000 cabe en los 8000 tokens/min de Groq (D-040).
CONTEXT_MAX_CHARS=12000

# Tamaño máximo de archivo (D-023, decidido). Vercel rechaza cuerpos > 4.5 MB.
MAX_UPLOAD_MB=4

# Cuotas diarias por usuario (día calendario America/Bogota)
GEN_DAILY_LIMIT=30
CHAT_DAILY_LIMIT=100
